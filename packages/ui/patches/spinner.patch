# spinner.tsx local deviation
# HugeiconsIcon types strokeWidth as a number, so the svg props type must not admit a string.
# Regenerate with: bun run ui:refresh-patches
diff --git a/packages/ui/src/components/spinner.tsx b/packages/ui/src/components/spinner.tsx
--- a/packages/ui/src/components/spinner.tsx
+++ b/packages/ui/src/components/spinner.tsx
@@ -2,7 +2,12 @@ import { cn } from "@workspace/ui/lib/utils"
 
 import { HugeiconsIcon } from "@hugeicons/react"
 import { Loading03Icon } from "@hugeicons/core-free-icons"
-function Spinner({ className, ...props }: React.ComponentProps<"svg">) {
+// Local fix: HugeiconsIcon types strokeWidth as number; the plain svg props
+// type would let a string strokeWidth through and fail tsc.
+function Spinner({
+  className,
+  ...props
+}: Omit<React.ComponentProps<"svg">, "strokeWidth">) {
   return (
     <HugeiconsIcon icon={Loading03Icon} strokeWidth={2} data-slot="spinner" role="status" aria-label="Loading" className={cn("size-4 animate-spin", className)} {...props} />
   )
