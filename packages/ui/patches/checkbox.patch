# checkbox.tsx local deviation
# Base UI omits data-checked while indeterminate, so the mixed state needs its own fill and a minus glyph.
# Regenerate with: bun run ui:refresh-patches
diff --git a/packages/ui/src/components/checkbox.tsx b/packages/ui/src/components/checkbox.tsx
--- a/packages/ui/src/components/checkbox.tsx
+++ b/packages/ui/src/components/checkbox.tsx
@@ -4,14 +4,28 @@ import { Checkbox as CheckboxPrimitive } from "@base-ui/react/checkbox"
 
 import { cn } from "@workspace/ui/lib/utils"
 import { HugeiconsIcon } from "@hugeicons/react"
-import { Tick02Icon } from "@hugeicons/core-free-icons"
+import { MinusSignIcon, Tick02Icon } from "@hugeicons/core-free-icons"
 
-function Checkbox({ className, ...props }: CheckboxPrimitive.Root.Props) {
+// Deviation from vendored shadcn: Base UI's Checkbox omits `data-checked` on
+// the root when `indeterminate` is set (it only ever stamps one of
+// data-checked/data-unchecked/data-indeterminate), so the upstream styling
+// (keyed off data-checked only) left the "some selected" state unfilled with
+// a bare tick, indistinguishable from "none". Fix: mirror the data-checked
+// fill styles for data-indeterminate, and render both the tick and a minus
+// glyph in the Indicator (which Base UI still mounts while indeterminate),
+// toggling on the `indeterminate` prop itself rather than a CSS attribute
+// selector, since the prop is already threaded through to us.
+function Checkbox({
+  className,
+  indeterminate,
+  ...props
+}: CheckboxPrimitive.Root.Props) {
   return (
     <CheckboxPrimitive.Root
       data-slot="checkbox"
+      indeterminate={indeterminate}
       className={cn(
-        "peer relative flex size-4 shrink-0 items-center justify-center rounded-[4px] border border-input shadow-xs transition-shadow outline-none group-has-disabled/field:opacity-50 after:absolute after:-inset-x-3 after:-inset-y-2 focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 aria-invalid:aria-checked:border-primary dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 data-checked:border-primary data-checked:bg-primary data-checked:text-primary-foreground dark:data-checked:bg-primary",
+        "peer relative flex size-4 shrink-0 items-center justify-center rounded-[4px] border border-input shadow-xs transition-shadow outline-none group-has-disabled/field:opacity-50 after:absolute after:-inset-x-3 after:-inset-y-2 focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 aria-invalid:aria-checked:border-primary dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 data-checked:border-primary data-checked:bg-primary data-checked:text-primary-foreground dark:data-checked:bg-primary data-indeterminate:border-primary data-indeterminate:bg-primary data-indeterminate:text-primary-foreground dark:data-indeterminate:bg-primary",
         className
       )}
       {...props}
@@ -20,7 +34,11 @@ function Checkbox({ className, ...props }: CheckboxPrimitive.Root.Props) {
         data-slot="checkbox-indicator"
         className="grid place-content-center text-current transition-none [&>svg]:size-3.5"
       >
-        <HugeiconsIcon icon={Tick02Icon} strokeWidth={2} />
+        {indeterminate === true ? (
+          <HugeiconsIcon icon={MinusSignIcon} strokeWidth={2} />
+        ) : (
+          <HugeiconsIcon icon={Tick02Icon} strokeWidth={2} />
+        )}
       </CheckboxPrimitive.Indicator>
     </CheckboxPrimitive.Root>
   )
