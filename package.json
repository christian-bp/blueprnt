{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean:cache": "rm -rf apps/*/.next .turbo apps/*/.turbo packages/*/.turbo",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/.next .turbo apps/*/.turbo packages/*/.turbo && bun install",
    "db:reset": "bun run --cwd packages/backend db:reset",
    "ui:update": "bun run --cwd packages/ui ui:update",
    "ui:refresh-patches": "bun run --cwd packages/ui ui:refresh-patches",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.13.0",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "next": "16.3.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "socket.io-parser": "4.2.7",
    "undici": "7.29.0",
    "ws": "8.21.0"
  }
}
